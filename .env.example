# Docker Compose only. App and server have separate .env.example files.
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PUBLISHED_PORT=8890
# Initial credentials apply only when storage/admin/credentials.json is absent.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-at-least-12-characters
# Match the owner of storage/admin and packages/content/data (id -u / id -g).
# SELAH_UID=1000
# SELAH_GID=1000
SELAH_IMAGE_TAG=local
# NODE_IMAGE=node:22-alpine
