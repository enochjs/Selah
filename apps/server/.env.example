# Copy to apps/server/.env or .env.local. Existing process environment wins.
HOST=127.0.0.1
PORT=8890
ADMIN_USERNAME=admin
# Set a 12–512 character password before first initialization.
# If omitted, a random initial password is displayed once.
# ADMIN_PASSWORD=replace-with-a-long-private-password

# Relative paths resolve from the physical repository root, never cwd.
CONTENT_ROOT=packages/content/data
MEDIA_ROOT=storage/resources/media
ADMIN_STATE_ROOT=storage/admin
RESOURCE_AUDIT_ROOT=storage/resources/audits
TIMING_ROOT=storage/resources/timing-overrides
ALIGNMENT_ROOT=storage/alignment

# Optional legacy chapter audio source (containing assets/mp3/).
# BIBLE_RESOURCE_ROOT=/absolute/path/to/legacy-source

# ADMIN_HOST and ADMIN_PORT are supported when HOST and PORT are unset.
