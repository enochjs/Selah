  "baseEvidenceSha256": "53a64f7eacb0737cba9f7e0cf4592bfbbc7106c4a5ab567529c1a3678003fb1a",
  "usfm": "PSA",
  "chapter": 30,
  "weakVerses": [],
  "failureReasons": [],
  "gapAssignments": [],
  "finalCues": [
    {
      "verse": 1,
      "text": "I will exalt you, LORD, for you lifted me out of the depths and did not let my enemies gloat over me.",
      "start": 6.54,
      "end": 13.24
    },
    {
      "verse": 2,
      "text": "LORD my God, I called to you for help, and you healed me.",
      "start": 13.24,
      "end": 17.94
    },
    {
      "verse": 3,
      "text": "You, LORD, brought me up from the realm of the dead; you spared me from going down to the pit.",
      "start": 18.683,
      "end": 23.86
    },
    {
      "verse": 4,
      "text": "Sing the praises of the LORD, you his faithful people; praise his holy name.",
      "start": 24.803,
      "end": 30.199
    },
    {
      "verse": 5,
      "text": "For his anger lasts only a moment, but his favor lasts a lifetime; weeping may stay for the night, but rejoicing comes in the morning.",
      "start": 30.62,
      "end": 40.84
    },
    {
      "verse": 6,
      "text": "When I felt secure, I said, “I will never be shaken.”",
      "start": 41.5,
      "end": 45.799
    },
    {
      "verse": 7,
      "text": "LORD, when you favored me, you made my royal mountain stand firm; but when you hid your face, I was dismayed.",
      "start": 46.461,
      "end": 53.86
    },
    {
      "verse": 8,
      "text": "To you, LORD, I called; to the Lord I cried for mercy:",
      "start": 54.36,
      "end": 57.629
    },
    {
      "verse": 9,
      "text": "“What is gained if I am silenced, if I go down to the pit? Will the dust praise you? Will it proclaim your faithfulness?",
      "start": 58.1,
      "end": 65.34
    },
    {
      "verse": 10,
      "text": "Hear, LORD, and be merciful to me; LORD, be my help.”",
      "start": 65.92,
      "end": 70.679
    },
    {
      "verse": 11,
      "text": "You turned my wailing into dancing; you removed my sackcloth and clothed me with joy,",
      "start": 71.32,
      "end": 77.519
    },
    {
      "verse": 12,
      "text": "that my heart may sing your praises and not be silent. LORD my God, I will praise you forever.",
      "start": 78.04,
      "end": 85.879
    }
  ],
