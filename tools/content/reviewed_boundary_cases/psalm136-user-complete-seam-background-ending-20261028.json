  "finalCues": [
    {
      "verse": 1,
      "text": "Give thanks to the LORD, for he is good. His love endures forever.",
      "start": 2.24,
      "end": 7.439
    },
    {
      "verse": 2,
      "text": "Give thanks to the God of gods. His love endures forever.",
      "start": 8.08,
      "end": 12.379
    },
    {
      "verse": 3,
      "text": "Give thanks to the Lord of lords: His love endures forever.",
      "start": 12.72,
      "end": 17.24
    },
    {
      "verse": 4,
      "text": "to him who alone does great wonders, His love endures forever.",
      "start": 17.802,
      "end": 23.52
    },
    {
      "verse": 5,
      "text": "who by his understanding made the heavens, His love endures forever.",
      "start": 23.6,
      "end": 28.01
    },
    {
      "verse": 6,
      "text": "who spread out the earth upon the waters, His love endures forever.",
      "start": 28.07,
      "end": 33.1
    },
    {
      "verse": 7,
      "text": "who made the great lights— His love endures forever.",
      "start": 33.14,
      "end": 36.61
    },
    {
      "verse": 8,
      "text": "the sun to govern the day, His love endures forever.",
      "start": 36.74,
      "end": 40.59
    },
    {
      "verse": 9,
      "text": "the moon and stars to govern the night; His love endures forever.",
      "start": 40.64,
      "end": 45.48
    },
    {
      "verse": 10,
      "text": "to him who struck down the firstborn of Egypt His love endures forever.",
      "start": 45.801,
      "end": 51.18
    },
    {
      "verse": 11,
      "text": "and brought Israel out from among them His love endures forever.",
      "start": 51.18,
      "end": 55.93
    },
    {
      "verse": 12,
      "text": "with a mighty hand and outstretched arm; His love endures forever.",
      "start": 55.93,
      "end": 60.96
    },
    {
      "verse": 13,
      "text": "to him who divided the Red Sea asunder His love endures forever.",
      "start": 60.96,
      "end": 65.6
    },
    {
      "verse": 14,
      "text": "and brought Israel through the midst of it, His love endures forever.",
      "start": 65.6,
      "end": 69.98
    },
    {
      "verse": 15,
      "text": "but swept Pharaoh and his army into the Red Sea; His love endures forever.",
      "start": 69.98,
      "end": 75.75
    },
    {
      "verse": 16,
      "text": "to him who led his people through the wilderness; His love endures forever.",
      "start": 76.011,
      "end": 80.93
    },
    {
      "verse": 17,
      "text": "to him who struck down great kings, His love endures forever.",
      "start": 81.06,
      "end": 86.08
    },
    {
      "verse": 18,
      "text": "and killed mighty kings— His love endures forever.",
      "start": 86.14,
      "end": 89.89
    },
    {
      "verse": 19,
      "text": "Sihon king of the Amorites His love endures forever.",
      "start": 90.02,
      "end": 94.2
    },
    {
      "verse": 20,
      "text": "and Og king of Bashan— His love endures forever.",
      "start": 94.26,
      "end": 98.19
    },
    {
      "verse": 21,
      "text": "and gave their land as an inheritance, His love endures forever.",
      "start": 98.24,
      "end": 103.16
    },
    {
      "verse": 22,
      "text": "an inheritance to his servant Israel. His love endures forever.",
      "start": 103.602,
      "end": 108.459
    },
    {
      "verse": 23,
      "text": "He remembered us in our low estate His love endures forever.",
      "start": 108.66,
      "end": 113.93
    },
    {
      "verse": 24,
      "text": "and freed us from our enemies. His love endures forever.",
      "start": 114.04,
      "end": 119.24
    },
    {
      "verse": 25,
      "text": "He gives food to every creature. His love endures forever.",
      "start": 119.5,
      "end": 124.49
    },
    {
      "verse": 26,
      "text": "Give thanks to the God of heaven. His love endures forever.",
      "start": 124.68,
      "end": 131.2
    }
  ],
