  "finalCues": [
    {
      "verse": 1,
      "text": "Those who trust in the LORD are like Mount Zion, which cannot be shaken but endures forever.",
      "start": 4.17,
      "end": 10.984
    },
    {
      "verse": 2,
      "text": "As the mountains surround Jerusalem, so the LORD surrounds his people both now and forevermore.",
      "start": 11.128,
      "end": 19.12
    },
    {
      "verse": 3,
      "text": "The scepter of the wicked will not remain over the land allotted to the righteous, for then the righteous might use their hands to do evil.",
      "start": 19.12,
      "end": 28.584
    },
    {
      "verse": 4,
      "text": "LORD, do good to those who are good, to those who are upright in heart.",
      "start": 29.401,
      "end": 34.37
    },
    {
      "verse": 5,
      "text": "But those who turn to crooked ways the LORD will banish with the evildoers. Peace be on Israel.",
      "start": 34.6,
      "end": 41.8
    }
  ],
